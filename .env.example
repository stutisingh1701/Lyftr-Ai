# Lyftr AI Configuration

# Comma-separated list of key_id:api_key pairs or standard api_key values
# Format: key_1:sk-proj-...,key_2:sk-proj-... OR gsk_...,gsk_...
LLM_API_KEYS=key_1:dummy_key_1,key_2:dummy_key_2

# LiteLLM model identifier (e.g., gemini/gemini-3.5-flash-lite, openai/gpt-4o-mini, groq/llama-3.1-70b-versatile)
LLM_MODEL=gemini/gemini-3.5-flash-lite

# SQLite connection URL with persistent storage volume
DATABASE_URL=sqlite:////data/app.db

# CORS allowed origins (comma-separated, no trailing slashes; e.g. https://your-app.vercel.app)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Feature flag for header-based failure simulation (X-Simulate-Failure)
ENABLE_FAILURE_SIMULATION=true

# Frontend environment variables (set to your Render backend URL on Vercel)
VITE_API_URL=http://localhost:8000
